{
  "manifest_version": 3,
  "name": "Pebble — AI Study Tutor & Companion",
  "version": "2.0.0",
  "description": "Chrome Side Panel AI Study Tutor powered by Gemini with a virtual Study Companion pet that levels up as you summarize, quiz, and learn.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "Open Pebble Study Tutor"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
