{
  "manifest_version": 3,
  "name": "Pebble — AI Study Tutor & Companion",
  "version": "2.2.0",
  "description": "Chrome Side Panel AI Study Tutor supporting free & BYOK models (Gemini, OpenRouter, OpenAI, Claude, Ollama) with Socratic mode, LaTeX math, YouTube transcripts, screenshots, and a virtual Study Companion pet.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Open Pebble Study Tutor"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
