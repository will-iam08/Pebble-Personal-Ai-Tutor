# Required: Google Gemini API key (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Override the Gemini model used by server/index.ts (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Optional: Local server port (default: 3000)
PORT=3000
